FROM rust:slim-bookworm AS builder
RUN apt-get update && apt-get install -y pkg-config libssl-dev clang && rm -rf /var/lib/apt/lists/*
WORKDIR /usr/src/aegisdns
COPY . .
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse
RUN cargo build --release --locked --bin openroot

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /usr/src/aegisdns/target/release/openroot /usr/local/bin/openroot
USER 10001:10001
EXPOSE 5354/udp 5354/tcp
CMD ["openroot"]
