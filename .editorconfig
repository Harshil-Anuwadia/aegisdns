root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,yml,yaml}]
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4

[*.{json,js,jsx,ts,tsx,css}]
indent_style = space
indent_size = 2

[*.{rs,toml}]
indent_style = space
indent_size = 4

[*.bat]
end_of_line = crlf
