cmd_update() {
    hdr "Updating AegisDNS"

    cd "$AEGIS_DIR"

    # Git pull
    if [ -d .git ]; then
        if [ -n "$(git status --porcelain --untracked-files=normal 2>/dev/null)" ]; then
            fail "The repository has uncommitted changes; commit or stash them before updating"
            return 1
        fi
        info "Pulling latest code..."
        if ! git pull --ff-only 2>&1 | sed 's/^/     /'; then
            fail "Could not update the repository"
            return 1
        fi
        echo ""
    else
        warn "Not a git repo — skipping code update"
    fi

    # Rebuild
    require_docker
    info "Rebuilding container..."
    if ! docker_cmd compose build 2>&1 | tail -5; then
        fail "Container build failed"
        return 1
    fi
    ok "Build complete"

    # Restart if running
    if is_running; then
        info "Restarting..."
        if ! docker_cmd compose restart 2>&1 | tail -3; then
            fail "Container restart failed"
            return 1
        fi
        if wait_for_api; then
            ok "AegisDNS updated and running"
        else
            warn "Restarted but API not responding — check logs"
        fi
    else
        info "Not running — start with: aegis start"
    fi
    echo ""
}

cmd_reset() {
    hdr "${YELLOW}Reset AegisDNS${NC}"
    echo -e "  This will wipe ALL data and start fresh:"
    echo -e "    ${DIM}• Query logs & analytics${NC}"
    echo -e "    ${DIM}• Registered devices${NC}"
    echo -e "    ${DIM}• Policy rules (allow/deny)${NC}"
    echo -e "    ${DIM}• Blocklist subscriptions${NC}"
    echo -e "    ${DIM}• Schedule rules${NC}"
    echo -e ""
    echo -e "  ${GREEN}Keeping:${NC} Docker image, config.json, CLI"
    echo ""
    read -rp "  Are you sure? (y/N): " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        info "Cancelled"
        echo ""
        return 0
    fi
    echo ""

    require_docker

    # Stop container and wipe volumes
    cd "$AEGIS_DIR"
    local was_running=false
    if is_running; then
        was_running=true
        info "Stopping AegisDNS and wiping data volume..."
    else
        info "Wiping data volume..."
    fi
    
    if ! docker_cmd compose down -v; then
        fail "Could not remove the AegisDNS data volume"
        return 1
    fi
    ok "Container stopped and all data wiped"

    # Restart if it was running before
    if $was_running; then
        echo ""
        info "Restarting AegisDNS with clean state..."
        cd "$AEGIS_DIR"
        if ! docker_cmd compose up -d || ! wait_for_api; then
            fail "Data was reset, but AegisDNS did not restart successfully"
            return 1
        fi
        ok "AegisDNS restarted with clean state"
        activate_dns
    fi

    if $was_running; then
        echo -e "\n  ${GREEN}${BOLD}Reset complete!${NC} AegisDNS is running with clean state."
    else
        echo -e "\n  ${GREEN}${BOLD}Reset complete!${NC} Start AegisDNS when you are ready."
    fi
    echo -e "  ${DIM}Add your devices back with: aegis device add <ip> <name>${NC}\n"
}

cmd_uninstall() {
    hdr "${RED}Uninstall AegisDNS${NC}"
    echo -e "  This will stop the container, restore your DNS, and clean up.\n"
    read -rp "  Are you sure? (y/N): " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        info "Cancelled"
        echo ""
        return 0
    fi
    echo ""

    # Stop container
    if is_running || container_exists; then
        cd "$AEGIS_DIR"
        if docker_cmd compose down; then ok "Container stopped"; else warn "Container cleanup failed"; fi
    elif ! select_docker; then
        warn "Docker is unavailable; continuing with host cleanup"
    fi

    # Restore DNS
    restore_dns

    # Remove docker volume
    read -rp "  Remove stored data (policies, analytics, blocklists)? (y/N): " rmdata
    if [[ "$rmdata" =~ ^[Yy]$ ]]; then
        if ! select_docker; then
            warn "Docker is unavailable, so the data volume could not be removed"
        elif docker_cmd volume rm aegisdns_data 2>/dev/null; then
            ok "Removed data volume"
        else
            warn "The Docker data volume was already absent or could not be removed"
        fi
    fi

    # Remove CLI symlink
    if [ -L /usr/local/bin/aegis ]; then
        read -rp "  Remove 'aegis' command from system? (y/N): " rmcli
        if [[ "$rmcli" =~ ^[Yy]$ ]]; then
            sudo rm -f /usr/local/bin/aegis 2>/dev/null || true
            ok "Removed /usr/local/bin/aegis"
        fi
    fi

    # Cleanup backup
    rm -rf "$BACKUP_DIR"
    ok "Cleaned up backup files"

    echo -e "\n  ${GREEN}AegisDNS has been uninstalled. Your DNS is back to normal.${NC}\n"
}

cmd_version() {
    echo -e "AegisDNS CLI v${VERSION}"
    if is_running; then
        echo -e "Container: ${GREEN}running${NC}"
    else
        echo -e "Container: ${RED}stopped${NC}"
    fi
}

