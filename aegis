# ── Main ────────────────────────────────────────────────────
case "${1:-help}" in
    start)                          cmd_start ;;
    stop)                           cmd_stop ;;
    restart)                        cmd_restart ;;
    status|st)                      cmd_status ;;
    logs|log)
        if [ "${2:-}" = "-f" ] || [ "${2:-}" = "--follow" ]; then
            cmd_logs_follow
        else
            cmd_logs "${2:-50}"
        fi
        ;;
    build)                          cmd_build ;;
    rebuild)                        cmd_rebuild ;;
    allow|whitelist)                cmd_allow "${2:-}" "${3:-}" ;;
    deny|block)                     cmd_deny "${2:-}" "${3:-}" ;;
    remove|unallow|unblock)         cmd_remove "${2:-}" "${3:-}" ;;
    policy|rules)                   cmd_policy ;;
    stats)                          cmd_stats "${2:-}" ;;
    device)                         cmd_device "${2:-}" "${3:-}" "${4:-}" ;;
    devices)                        cmd_devices ;;
    test|check)                     cmd_test "${2:-}" ;;
    risk|scan)                      cmd_risk "${2:-}" ;;
    quarantine)                     cmd_quarantine ;;
    unquarantine|release)           cmd_unquarantine "${2:-}" ;;
    safesearch|safe)                cmd_safesearch "${2:-}" ;;
    flush|clear)                    cmd_flush "${2:-all}" ;;
    ip|network)                     cmd_ip ;;
    config|cfg)                     cmd_config "${2:-show}" ;;
    dashboard|dash|ui|web)          cmd_dashboard ;;
    credentials|credential|password) cmd_credentials ;;
    update|upgrade)                 cmd_update ;;
    reset)                          cmd_reset ;;
    uninstall)                      cmd_uninstall ;;
    version|-v|--version)           cmd_version ;;
    help|-h|--help)                 cmd_help ;;
    *)
        fail "Unknown command: $1"
        echo -e "     Run ${DIM}aegis help${NC} for all commands\n"
        exit 1
        ;;
esac
