cmd_test() {
    hdr "DNS Test"

    local domain="${1:-google.com}"

    # Test if DNS resolution works
    info "Testing DNS resolution for $domain..."
    if command -v dig &>/dev/null; then
        local result status
        result=$(dig +time=2 +tries=1 "$domain" @127.0.0.1 2>/dev/null || true)
        status=$(printf '%s\n' "$result" | sed -n 's/.*status: \([A-Z]*\),.*/\1/p' | head -n 1)
        if [ "$status" = "NOERROR" ]; then
            local answer
            answer=$(printf '%s\n' "$result" | awk '$4=="A" || $4=="AAAA" {print $5; exit}')
            [ -n "$answer" ] || answer="NOERROR (no address record)"
            ok "Resolved $domain → $answer"
        elif [ "$status" = "NXDOMAIN" ]; then
            warn "$domain is blocked or does not exist (NXDOMAIN)"
        else
            fail "Could not resolve $domain via AegisDNS (${status:-no response})"
        fi
    elif command -v nslookup &>/dev/null; then
        if nslookup "$domain" 127.0.0.1 &>/dev/null; then
            ok "Resolved $domain via AegisDNS"
        else
            fail "Could not resolve $domain via AegisDNS"
        fi
    else
        warn "Neither 'dig' nor 'nslookup' found — install dnsutils"
    fi

    # Test if a known tracker is blocked
    info "Testing if tracker blocking works..."
    if command -v dig &>/dev/null; then
        local blocked_result blocked_status
        blocked_result=$(dig +time=2 +tries=1 "graph.facebook.com" @127.0.0.1 2>/dev/null || true)
        blocked_status=$(printf '%s\n' "$blocked_result" | sed -n 's/.*status: \([A-Z]*\),.*/\1/p' | head -n 1)
        if [ "$blocked_status" = "NXDOMAIN" ] || printf '%s\n' "$blocked_result" | grep -Eq '[[:space:]](127\.0\.0\.[0-9]+|0\.0\.0\.0)[[:space:]]*$'; then
            ok "Tracker blocking is working (graph.facebook.com blocked)"
        elif [ -z "$blocked_status" ] || [ "$blocked_status" = "SERVFAIL" ]; then
            fail "Blocking test got ${blocked_status:-no response}; DNS is not healthy"
        else
            warn "graph.facebook.com is not blocked by the active lists"
        fi
    fi

    # Diagnose a domain via API
    if is_running && [ -n "${1:-}" ]; then
        echo ""
        info "API diagnosis for $domain..."
        local diag
        diag=$(api_post "diagnose" "{\"domain\":\"$(json_escape "$domain")\"}")
        if [ -n "$diag" ]; then
            echo -e "  ${DIM}$diag${NC}"
        fi
    fi
    echo ""
}

