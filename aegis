cmd_device() {
    local subcmd="${1:-list}"
    shift 2>/dev/null || true

    case "$subcmd" in
        add)
            local ip="${1:-}"
            local name="${2:-}"
            if [ -z "$ip" ] || [ -z "$name" ]; then
                fail "Usage: aegis device add <ip> <name>"
                echo -e "     Example: ${DIM}aegis device add 100.64.0.1 \"My Phone\"${NC}"
                exit 1
            fi
            require_running

            local resp
            resp=$(api_post "devices" "{\"ip\":\"$(json_escape "$ip")\",\"name\":\"$(json_escape "$name")\"}")
            if [ -z "$resp" ]; then
                fail "Could not reach API"
                return 1
            fi
            local success
            success=$(json_val "$resp" "success")
            if [ "$success" = "true" ]; then
                ok "Added device: ${BOLD}$name${NC} ($ip)"
            else
                local msg
                msg=$(json_val "$resp" "message")
                fail "$msg"
            fi
            echo ""
            ;;
        remove|rm|del|delete)
            local ip="${1:-}"
            if [ -z "$ip" ]; then
                fail "Usage: aegis device remove <ip>"
                exit 1
            fi
            require_running

            local resp
            resp=$(api_delete "devices/$(url_encode "$ip")")
            if [ -z "$resp" ]; then
                fail "Could not reach API"
                return 1
            fi
            local success
            success=$(json_val "$resp" "success")
            if [ "$success" = "true" ]; then
                ok "Removed device: $ip"
            else
                local msg
                msg=$(json_val "$resp" "message")
                fail "$msg"
            fi
            echo ""
            ;;
        list|ls|"")
            require_running
            hdr "Registered Devices"
            local devices
            devices=$(api_get "devices")
            if [ -z "$devices" ] || [ "$devices" = "[]" ]; then
                warn "No devices registered"
                echo -e "     Add one: ${DIM}aegis device add <ip> <name>${NC}"
                echo ""
                return
            fi

            # Parse JSON array of {ip, name} objects
            echo "$devices" | python3 -c "
import json, sys
devs = json.load(sys.stdin)
for d in devs:
    print(f\"  \033[0;36m●\033[0m {d['name']:20s}  \033[2m{d['ip']}\033[0m\")
" 2>/dev/null || echo -e "  ${DIM}$devices${NC}"
            echo ""
            ;;
        *)
            fail "Unknown device subcommand: $subcmd"
            echo -e "     Usage: ${DIM}aegis device [add|remove|list]${NC}\n"
            ;;
    esac
}

