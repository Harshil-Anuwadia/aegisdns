#!/bin/bash
# ══════════════════════════════════════════════════════════════
# AegisDNS CLI — Full control over your DNS fortress
# ══════════════════════════════════════════════════════════════
set -o pipefail

VERSION="1.0.0"

# ── Config ──────────────────────────────────────────────────
SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -h "$SOURCE_PATH" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
    SOURCE_PATH="$(readlink "$SOURCE_PATH")"
    [[ "$SOURCE_PATH" != /* ]] && SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH"
done
AEGIS_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
BACKUP_DIR="$AEGIS_DIR/.dns-backup"
BACKUP_RESOLV="$BACKUP_DIR/resolv.conf.bak"
BACKUP_STUB="$BACKUP_DIR/stub-state.bak"
BACKUP_SYMLINK="$BACKUP_DIR/resolv-symlink.bak"
BACKUP_TAILSCALE="$BACKUP_DIR/tailscale-dns.bak"
BACKUP_MARKER="$BACKUP_DIR/complete"
CONTAINER_NAME="aegisdns"
DASHBOARD_PORT="5380"
API="http://localhost:$DASHBOARD_PORT/api"

# ── Colors ──────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

ok()   { echo -e "  ${GREEN}✓${NC} $*"; }
fail() { echo -e "  ${RED}✗${NC} $*"; }
warn() { echo -e "  ${YELLOW}⚠${NC} $*"; }
info() { echo -e "  ${CYAN}→${NC} $*"; }
hdr()  { echo -e "\n${BOLD}$*${NC}\n"; }

# ── Helpers ─────────────────────────────────────────────────
DOCKER_CMD=()

select_docker() {
    [ ${#DOCKER_CMD[@]} -gt 0 ] && return 0
    command -v docker &>/dev/null || return 1
    if docker info &>/dev/null 2>&1; then
        DOCKER_CMD=(docker)
    elif command -v sudo &>/dev/null && sudo -n docker info &>/dev/null 2>&1; then
        DOCKER_CMD=(sudo docker)
    else
        return 1
    fi
}

docker_cmd() {
    select_docker || return 1
    "${DOCKER_CMD[@]}" "$@"
}

require_docker() {
    if ! command -v docker &>/dev/null; then
        fail "Docker is not installed"
        echo -e "     Install: ${DIM}curl -fsSL https://get.docker.com | sh${NC}"
        exit 1
    fi
    if ! select_docker; then
        fail "Docker daemon is not running"
        echo -e "     Start Docker, or open a new terminal if your user was just added to the docker group."
        echo -e "     Linux service: ${DIM}sudo systemctl start docker${NC}"
        exit 1
    fi
}

is_running() {
    docker_cmd inspect -f '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null | grep -q "true"
}

container_exists() {
    docker_cmd inspect "$CONTAINER_NAME" &>/dev/null
}

require_running() {
    if ! is_running; then
        fail "AegisDNS is not running"
        echo -e "     Run: ${DIM}aegis start${NC}"
        exit 1
    fi
}

detect_ip() {
    local ip=""
    # Only use Tailscale IP — local IPs (10.x, 192.168.x) are useless for
    # per-device tracking because DNS queries arrive via the Tailscale interface.
    if command -v tailscale &>/dev/null; then
        ip=$(tailscale ip -4 2>/dev/null || true)
    fi
    # Use a reachable LAN address when Tailscale is unavailable.
    if [ -z "$ip" ]; then
        if command -v ip &>/dev/null; then
            ip=$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1);exit}}')
        fi
    fi
    if [ -z "$ip" ] && command -v hostname &>/dev/null; then
        ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    fi
    if ! [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        ip="127.0.0.1"
    else
        local octet
        local -a _octets
        IFS=. read -r -a _octets <<< "$ip"
        for octet in "${_octets[@]}"; do
            if [ "$octet" -gt 255 ]; then ip="127.0.0.1"; break; fi
        done
    fi
    echo "$ip"
}

get_admin_password() {
    local password="${AEGIS_ADMIN_PASSWORD:-}"
    if [ -z "$password" ] && [ -f "$AEGIS_DIR/.env" ]; then
        password=$(sed -n 's/^AEGIS_ADMIN_PASSWORD=//p' "$AEGIS_DIR/.env" | tail -n 1)
    fi
    if [ -z "$password" ]; then
        if [ -r "${AEGIS_DATA_DIR:-/var/lib/aegisdns}/admin-password" ]; then
            password=$(cat "${AEGIS_DATA_DIR:-/var/lib/aegisdns}/admin-password")
        else
            password=$(docker_cmd exec -u 10001 "$CONTAINER_NAME" cat /var/lib/aegisdns/admin-password 2>/dev/null) || return 1
        fi
    fi
    [ -n "$password" ] || return 1
    printf '%s' "$password"
}

# API helper — silent on failure, returns empty string
# Credentials are passed on curl's stdin, never in process arguments.
auth_curl() {
    local password
    password=$(get_admin_password) || return 1
    local credential
    credential=$(printf 'admin:%s' "$password" | base64 | tr -d '\r\n')
    printf 'header = "Authorization: Basic %s"\nheader = "X-Aegis-Request: 1"\n' "$credential" | \
        curl --config - -sf --connect-timeout 3 --max-time 30 "$@"
}
api_get() {
    auth_curl "$API/$1" || return 1
}
api_post() {
    auth_curl -X POST "$API/$1" -H "Content-Type: application/json" --data-binary "$2" || return 1
}
api_delete() {
    if [ -n "${2:-}" ]; then
        auth_curl -X DELETE "$API/$1" -H "Content-Type: application/json" --data-binary "$2"
    else
        auth_curl -X DELETE "$API/$1"
    fi
}

# Wait for the API to become healthy after start
wait_for_api() {
    local attempts=0
    local max=15
    while [ $attempts -lt $max ]; do
        local code
        code=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 1 --max-time 2 "$API/stats" || echo "000")
        if [ "$code" = "200" ] || [ "$code" = "401" ]; then
            return 0
        fi
        sleep 1
        attempts=$((attempts + 1))
    done
    return 1
}

# Pretty-print JSON value
json_val() {
    local json="$1" key="$2"
    if command -v python3 &>/dev/null; then
        JSON_INPUT="$json" JSON_KEY="$key" python3 -c 'import json,os; v=json.loads(os.environ["JSON_INPUT"]).get(os.environ["JSON_KEY"], ""); print(str(v).lower() if isinstance(v,bool) else v)' 2>/dev/null
    else
        local value
        value=$(printf '%s\n' "$json" | sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -n 1)
        if [ -n "$value" ]; then printf '%s\n' "$value"; else
            printf '%s\n' "$json" | sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\([^,}]*\).*/\1/p" | head -n 1 | tr -d '[:space:]'
        fi
    fi
}

json_num() { json_val "$1" "$2"; }

json_escape() {
    local value="$1"
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//$'\n'/\\n}
    value=${value//$'\r'/\\r}
    value=${value//$'\t'/\\t}
    printf '%s' "$value"
}

url_encode() {
    local value="$1"
    if command -v python3 &>/dev/null; then
        URL_VALUE="$value" python3 -c 'import os,urllib.parse; print(urllib.parse.quote(os.environ["URL_VALUE"], safe=""))'
    else
        local out="" char hex i
        for ((i=0; i<${#value}; i++)); do
            char=${value:i:1}
            case "$char" in
                [a-zA-Z0-9.~_-]) out+="$char" ;;
                *) printf -v hex '%%%02X' "'$char"; out+="$hex" ;;
            esac
        done
        printf '%s\n' "$out"
    fi
}

response_succeeded() { [ "$(json_val "$1" success)" = "true" ]; }
response_message() { json_val "$1" message; }

print_domain_counts() {
    local json="$1" color="$2"
    if command -v python3 &>/dev/null; then
        JSON_INPUT="$json" python3 -c 'import json,os; data=json.loads(os.environ["JSON_INPUT"]); data=data.get("top_domains",[]) if isinstance(data,dict) else data; [print(f"{int(row.get(chr(99)+chr(111)+chr(117)+chr(110)+chr(116),0))}\t{row.get(chr(100)+chr(111)+chr(109)+chr(97)+chr(105)+chr(110),chr(63))}") for row in data[:5]]' 2>/dev/null |
        while IFS=$'\t' read -r count domain; do printf "  %b%6s%b  %s\n" "$color" "$count" "$NC" "$domain"; done
    else
        printf '  %b%s%b\n' "$DIM" "$json" "$NC"
    fi
}

print_policy_json() {
    local json="$1"
    if ! command -v python3 &>/dev/null; then
        printf '  %b%s%b\n' "$DIM" "$json" "$NC"
        return
    fi
    JSON_INPUT="$json" python3 -c '
import json, os
p=json.loads(os.environ["JSON_INPUT"])
sections=[("Global Allowed",p.get("allowed",[]),"✓"),("Global Denied",p.get("denied",[]),"✗")]
for ip,rules in sorted(p.get("device_allowed",{}).items()): sections.append((f"Allowed for {ip}",rules,"✓"))
for ip,rules in sorted(p.get("device_denied",{}).items()): sections.append((f"Denied for {ip}",rules,"✗"))
shown=False
for title,rules,mark in sections:
    if not rules: continue
    shown=True; print(f"  {title}")
    for domain in rules: print(f"    {mark} {domain}")
    print()
if not shown: print("  No custom rules configured")
' 2>/dev/null || printf '  %b%s%b\n' "$DIM" "$json" "$NC"
}

upsert_env_value() {
    local key="$1" value="$2" file="$AEGIS_DIR/.env" tmp
    tmp=$(mktemp "$AEGIS_DIR/.env.XXXXXX") || return 1
    if [ -f "$file" ]; then
        awk -v k="$key" -v v="$value" 'BEGIN{done=0} index($0,k "=")==1 {if(!done){print k "=" v;done=1};next} {print} END{if(!done)print k "=" v}' "$file" > "$tmp"
    else
        printf '%s=%s\n' "$key" "$value" > "$tmp"
    fi
    chmod 600 "$tmp"
    mv "$tmp" "$file"
}

# ── DNS Backup & Restore ───────────────────────────────────
backup_dns() {
    if [ -f "$BACKUP_MARKER" ]; then
        info "Using the existing DNS backup"
        return 0
    fi
    mkdir -p "$BACKUP_DIR"

    # Back up the exact resolver file, including files generated by Tailscale.
    if [ -f /etc/resolv.conf ]; then
        if ! cat /etc/resolv.conf > "$BACKUP_RESOLV" 2>/dev/null; then
            fail "Could not back up /etc/resolv.conf"
            return 1
        fi
        # Save the symlink target without relying on GNU readlink -f.
        if [ -L /etc/resolv.conf ]; then
            local link_target
            link_target=$(readlink /etc/resolv.conf) || return 1
            if [[ "$link_target" = /* ]]; then
                printf '%s\n' "$link_target" > "$BACKUP_SYMLINK"
            else
                printf '/etc/%s\n' "$link_target" > "$BACKUP_SYMLINK"
            fi
        else
            rm -f "$BACKUP_SYMLINK" 2>/dev/null || true
        fi
    fi

    # Save systemd-resolved stub listener state
    if command -v systemctl &>/dev/null && systemctl is-active --quiet systemd-resolved 2>/dev/null; then
        if [ -f /etc/systemd/resolved.conf.d/aegisdns.conf ]; then
            echo "stub_was_disabled" > "$BACKUP_STUB"
        else
            echo "stub_was_enabled" > "$BACKUP_STUB"
        fi
    fi
    if command -v tailscale &>/dev/null; then
        local prefs
        prefs=$(tailscale debug prefs 2>/dev/null || sudo -n tailscale debug prefs 2>/dev/null || true)
        if printf '%s\n' "$prefs" | grep -Eq '"CorpDNS"[[:space:]]*:[[:space:]]*true'; then
            echo "true" > "$BACKUP_TAILSCALE"
        elif printf '%s\n' "$prefs" | grep -Eq '"CorpDNS"[[:space:]]*:[[:space:]]*false'; then
            echo "false" > "$BACKUP_TAILSCALE"
        fi
    fi
    : > "$BACKUP_MARKER"
    ok "Backed up current DNS configuration"
}

activate_dns() {
    info "Configuring system DNS to use AegisDNS..."
    echo -e "     ${DIM}(you may be prompted for your sudo password)${NC}"

    # Handle systemd-resolved (free port 53)
    if command -v systemctl &>/dev/null; then
        if systemctl is-active --quiet systemd-resolved 2>/dev/null || systemctl is-enabled --quiet systemd-resolved 2>/dev/null; then
            sudo mkdir -p /etc/systemd/resolved.conf.d || return 1
            printf '[Resolve]\nDNSStubListener=no\n' | sudo tee /etc/systemd/resolved.conf.d/aegisdns.conf >/dev/null || return 1

            sudo systemctl unmask systemd-resolved.service 2>/dev/null || true
            if ! sudo systemctl restart systemd-resolved 2>/dev/null; then
                fail "Could not restart systemd-resolved"
                return 1
            fi
            ok "Disabled systemd-resolved stub listener (port 53 freed)"
        fi
    fi

    # Stop Tailscale from managing DNS — it overwrites /etc/resolv.conf otherwise,
    # redirecting all queries to 100.100.100.100 and bypassing AegisDNS entirely.
    if command -v tailscale &>/dev/null && sudo tailscale status &>/dev/null 2>&1; then
        if sudo tailscale set --accept-dns=false 2>/dev/null; then
            ok "Stopped Tailscale DNS management (AegisDNS takes over)"
        else
            warn "Could not disable Tailscale DNS management"
        fi
    fi

    # Write resolv.conf AFTER disabling Tailscale DNS so it doesn't clobber us
    sudo rm -f /etc/resolv.conf 2>/dev/null || return 1
    sudo bash -c 'printf "nameserver 127.0.0.1\n" > /etc/resolv.conf' || return 1
    ok "System DNS pointed to AegisDNS (127.0.0.1)"
}

restore_dns() {
    info "Restoring original DNS configuration..."
    echo -e "     ${DIM}(you may be prompted for your sudo password)${NC}"

    local failed=false restored_resolv=false

    # Restore the user's prior Tailscale DNS preference when it was detectable.
    if command -v tailscale &>/dev/null && [ -f "$BACKUP_TAILSCALE" ]; then
        local accept_dns
        accept_dns=$(cat "$BACKUP_TAILSCALE")
        if sudo tailscale set --accept-dns="$accept_dns" 2>/dev/null; then
            ok "Restored the previous Tailscale DNS preference"
        else
            warn "Could not restore the previous Tailscale DNS preference"
            failed=true
        fi
    fi

    # Restore systemd-resolved stub listener
    if [ -f "$BACKUP_STUB" ]; then
        local state
        state=$(cat "$BACKUP_STUB")
        if [ "$state" = "stub_was_enabled" ]; then
            if sudo rm -f /etc/systemd/resolved.conf.d/aegisdns.conf 2>/dev/null && sudo systemctl restart systemd-resolved 2>/dev/null; then
                ok "Re-enabled systemd-resolved stub listener"
            else
                warn "Could not re-enable the system DNS stub listener"
                failed=true
            fi
        fi
    elif [ -f /etc/systemd/resolved.conf.d/aegisdns.conf ]; then
        # No backup but our config exists — clean it up
        if sudo rm -f /etc/systemd/resolved.conf.d/aegisdns.conf 2>/dev/null && sudo systemctl restart systemd-resolved 2>/dev/null; then
            ok "Removed AegisDNS stub override"
        else
            warn "Could not remove the AegisDNS stub override"
            failed=true
        fi
    fi

    # Restore resolv.conf
    if [ -f "$BACKUP_SYMLINK" ]; then
        local target
        target=$(cat "$BACKUP_SYMLINK")
        if [ -f "$target" ]; then
            if sudo ln -sf "$target" /etc/resolv.conf 2>/dev/null; then
                ok "Restored resolv.conf → $target"
                restored_resolv=true
            else failed=true; fi
        elif [ -f "$BACKUP_RESOLV" ]; then
            if sudo cp "$BACKUP_RESOLV" /etc/resolv.conf 2>/dev/null; then
                ok "Restored resolv.conf from backup"
                restored_resolv=true
            else failed=true; fi
        fi
    elif [ -f "$BACKUP_RESOLV" ]; then
        if sudo cp "$BACKUP_RESOLV" /etc/resolv.conf 2>/dev/null; then
            ok "Restored resolv.conf from backup"
            restored_resolv=true
        else failed=true; fi
    else
        # With no saved file, reconnect to the system resolver when possible.
        if command -v systemctl &>/dev/null && systemctl is-active --quiet systemd-resolved 2>/dev/null; then
            if [ -f /run/systemd/resolve/stub-resolv.conf ]; then
                sudo ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf 2>/dev/null && restored_resolv=true || failed=true
            fi
        fi
        if ! $restored_resolv; then
            warn "No original resolv.conf backup is available; leaving the current resolver file in place"
        fi
    fi

    if $failed; then
        fail "DNS restoration was incomplete; backup retained at $BACKUP_DIR"
        return 1
    fi
    ok "System DNS restored"
    rm -rf "$BACKUP_DIR"
}

update_config() {
    local ip="$1"

    # Keep user-supplied secrets and options while refreshing the detected address.
    upsert_env_value "AEGIS_HOST_IP" "$ip" || {
        fail "Could not update $AEGIS_DIR/.env"
        return 1
    }

    # Create or update config.json
    if [ ! -f "$AEGIS_DIR/config.json" ]; then
        if [ "$ip" = "127.0.0.1" ]; then
            cat > "$AEGIS_DIR/config.json" <<EOF
{
  "host_ips": ["127.0.0.1"]
}
EOF
        else
            cat > "$AEGIS_DIR/config.json" <<EOF
{
  "host_ips": [
    "127.0.0.1",
    "$ip"
  ]
}
EOF
        fi
        ok "Created config.json with IP $ip"
    else
        if command -v python3 &>/dev/null; then
            if ! AEGIS_CONFIG_FILE="$AEGIS_DIR/config.json" python3 -c 'import json,os; c=json.load(open(os.environ["AEGIS_CONFIG_FILE"],encoding="utf-8")); assert isinstance(c,dict); assert isinstance(c.get("host_ips",[]),list)' 2>/dev/null; then
                fail "config.json is invalid; fix it or run: aegis config reset"
                return 1
            fi
        fi
        if ! grep -Fq "\"$ip\"" "$AEGIS_DIR/config.json" 2>/dev/null; then
            if command -v python3 &>/dev/null; then
                AEGIS_CONFIG_FILE="$AEGIS_DIR/config.json" AEGIS_NEW_IP="$ip" python3 -c '
import json, os
path, ip = os.environ["AEGIS_CONFIG_FILE"], os.environ["AEGIS_NEW_IP"]
with open(path, encoding="utf-8") as f: config = json.load(f)
ips = config.get("host_ips", ["127.0.0.1"])
if not isinstance(ips, list): raise ValueError("host_ips must be an array")
if ip not in ips: ips.append(ip)
config["host_ips"] = ips
tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as f: json.dump(config, f, indent=2); f.write("\n")
os.replace(tmp, path)
' 2>/dev/null && ok "Added $ip to config.json" || warn "Could not update config.json automatically — add \"$ip\" to host_ips manually"
            else
                fail "Python 3 is needed to safely add $ip to config.json"
                return 1
            fi
        else
            ok "config.json already contains $ip"
        fi
    fi
}

check_port53() {
    if command -v ss &>/dev/null; then
        if ss -tulpn 2>/dev/null | grep -Eq ':[5]3([^0-9]|$)'; then
            local owner
            owner=$(ss -tulpn 2>/dev/null | grep -E ':[5]3([^0-9]|$)' | head -1 | sed -n 's/.*users:(("\([^"]*\)".*/\1/p')
            [ -n "$owner" ] || owner="unknown"
            warn "Port 53 is in use by: $owner"
            return 1
        fi
    fi
    return 0
}

# ── Commands ────────────────────────────────────────────────

cmd_start() {
    hdr "Starting AegisDNS"
    require_docker

    if is_running; then
        ok "AegisDNS is already running"
        echo -e "     Use ${CYAN}aegis restart${NC} to restart\n"
        return 0
    fi

    # Report Tailscale state without taking ownership of the user's VPN service.
    if command -v tailscale &>/dev/null; then
        local ts_status
        ts_status=$(tailscale status 2>&1 || true)
        if echo "$ts_status" | grep -qi "stopped\|logged out\|NeedsLogin"; then
            warn "Tailscale is not logged in"
            echo -e "     Run: ${DIM}sudo tailscale up${NC} to log in"
            echo ""
        else
            ok "Tailscale is running"
        fi
    fi

    # Detect IP
    local ip
    ip=$(detect_ip)
    ok "Detected IP: $ip"

    # Update config files
    update_config "$ip" || return 1

    # Backup current DNS before we touch anything
    backup_dns || return 1

    # Free port 53 and activate DNS
    if ! activate_dns; then
        fail "Could not configure the host resolver"
        restore_dns || true
        return 1
    fi

    # Verify port 53 is free
    if ! check_port53; then
        warn "Attempting to continue anyway..."
    fi

    # Start container
    info "Starting container..."
    cd "$AEGIS_DIR"
    local compose_output
    if compose_output=$(docker_cmd compose up -d 2>&1); then
        printf '%s\n' "$compose_output" | grep -v "^$" | tail -5 || true
        # Health check
        info "Waiting for AegisDNS to be ready..."
        if wait_for_api; then
            # Auto-register the host device so it appears on the dashboard immediately
            local hname
            hname=$(hostname)
            api_post "devices" "{\"ip\":\"$(json_escape "$ip")\",\"name\":\"$(json_escape "$hname (Host)")\"}" >/dev/null 2>&1 || true

            echo ""
            ok "${GREEN}${BOLD}AegisDNS is running!${NC}"
            echo -e "     Dashboard: ${CYAN}http://localhost:$DASHBOARD_PORT${NC}"
            echo ""
        else
            echo ""
            fail "Container started but its API did not become ready"
            docker_cmd compose down >/dev/null 2>&1 || true
            restore_dns || true
            echo -e "     Check: ${DIM}aegis logs${NC}"
            echo ""
            return 1
        fi
    else
        echo ""
        fail "Failed to start container"
        warn "Restoring your DNS to previous state..."
        restore_dns
        echo -e "\n     Check: ${DIM}aegis logs${NC} or ${DIM}docker compose logs${NC}\n"
        return 1
    fi
}

cmd_stop() {
    hdr "Stopping AegisDNS"

    if is_running; then
        cd "$AEGIS_DIR"
        local compose_output
        if ! compose_output=$(docker_cmd compose down 2>&1); then
            printf '%s\n' "$compose_output" | tail -5
            fail "Could not stop the container"
            return 1
        fi
        printf '%s\n' "$compose_output" | grep -v "^$" | tail -5 || true
        ok "Container stopped"
    elif container_exists; then
        cd "$AEGIS_DIR"
        docker_cmd compose down 2>/dev/null || true
        ok "Cleaned up stopped container"
    else
        if select_docker; then
            info "AegisDNS was not running"
        else
            warn "Docker is unavailable; restoring host DNS without container cleanup"
        fi
    fi

    # Restore DNS to system default
    restore_dns || return 1

    echo -e "\n  ${GREEN}Everything stopped. System DNS restored to defaults.${NC}\n"
}

cmd_restart() {
    hdr "Restarting AegisDNS"
    require_docker

    if is_running; then
        cd "$AEGIS_DIR"

        # Refresh IP and config before restart
        local ip
        ip=$(detect_ip)
        update_config "$ip" || return 1

        # Re-assert DNS ownership — Tailscale may have re-grabbed resolv.conf
        backup_dns || return 1
        activate_dns || return 1

        # Recreate container in case image was updated
        local compose_output
        if ! compose_output=$(docker_cmd compose up -d 2>&1); then
            printf '%s\n' "$compose_output" | tail -5
            fail "Container restart failed"
            return 1
        fi
        printf '%s\n' "$compose_output" | grep -v "^$" | tail -5 || true

        info "Waiting for API..."
        if wait_for_api; then
            # Auto-register the host device so it appears on the dashboard immediately
            local hname
            hname=$(hostname)
            api_post "devices" "{\"ip\":\"$(json_escape "$ip")\",\"name\":\"$(json_escape "$hname (Host)")\"}" >/dev/null 2>&1 || true

            ok "AegisDNS restarted"
            echo -e "     Dashboard: ${CYAN}http://localhost:$DASHBOARD_PORT${NC}\n"
        else
            fail "Restarted but API is not responding — check logs"
            echo ""
            return 1
        fi
    else
        info "Not running — doing a full start instead"
        cmd_start
    fi
}

cmd_status() {
    hdr "AegisDNS Status"

    # ── Container ──
    if is_running; then
        local started
        started=$(docker_cmd inspect -f '{{.State.StartedAt}}' "$CONTAINER_NAME" 2>/dev/null | cut -d'.' -f1 | sed 's/T/ /' || echo "?")
        local mem
        mem=$(docker_cmd stats --no-stream --format '{{.MemUsage}}' "$CONTAINER_NAME" 2>/dev/null || echo "?")
        ok "Container: ${GREEN}running${NC}  ${DIM}(since $started | mem: $mem)${NC}"
    else
        fail "Container: ${RED}stopped${NC}"
    fi

    # ── Network ──
    local ip
    ip=$(detect_ip)
    info "Host IP: $ip"

    if command -v tailscale &>/dev/null; then
        local ts_ip
        ts_ip=$(tailscale ip -4 2>/dev/null || echo "")
        if [ -n "$ts_ip" ]; then
            info "Tailscale IP: $ts_ip"
        else
            info "Tailscale: installed but not connected"
        fi
    fi

    # ── DNS ──
    if [ -f /etc/resolv.conf ]; then
        local dns
        dns=$(grep "^nameserver" /etc/resolv.conf 2>/dev/null | awk '{print $2}' | tr '\n' ', ' | sed 's/,$//')
        info "System DNS: $dns"
    fi

    if [ -f /etc/systemd/resolved.conf.d/aegisdns.conf ]; then
        info "Stub listener: ${YELLOW}disabled by AegisDNS${NC}"
    elif command -v systemctl &>/dev/null && systemctl is-active --quiet systemd-resolved 2>/dev/null; then
        info "Stub listener: active (default)"
    fi

    # ── Config ──
    if [ -f "$AEGIS_DIR/config.json" ]; then
        if grep -q "\"$ip\"" "$AEGIS_DIR/config.json" 2>/dev/null; then
            ok "config.json: contains your IP"
        else
            warn "config.json: ${YELLOW}missing your IP ($ip)${NC} — run ${DIM}aegis restart${NC} to fix"
        fi
    else
        warn "config.json: not found — run ${DIM}aegis start${NC} to create"
    fi

    if [ -f "$BACKUP_RESOLV" ]; then
        ok "DNS backup: saved (will restore on ${DIM}aegis stop${NC})"
    else
        info "DNS backup: none"
    fi

    # ── Live Stats ──
    if is_running; then
        local stats
        stats=$(api_get "stats")
        if [ -n "$stats" ]; then
            local queries blocked allowed cache_hits latency
            queries=$(json_num "$stats" "queries_today")
            blocked=$(json_num "$stats" "blocked_today")
            allowed=$(json_num "$stats" "allowed_today")
            cache_hits=$(json_num "$stats" "cache_hits")
            latency=$(json_num "$stats" "avg_latency_ms")

            local pct="0"
            if [ "${queries:-0}" -gt 0 ] 2>/dev/null; then
                pct=$(awk "BEGIN{printf \"%.1f\", ${blocked:-0}/${queries}*100}")
            fi

            echo ""
            echo -e "  ${BOLD}Today${NC}  ${queries:-0} queries | ${RED}${blocked:-0} blocked${NC} ($pct%) | ${GREEN}${allowed:-0} allowed${NC} | ${CYAN}${cache_hits:-0} cached${NC} | ${latency:-0}ms avg"
        fi

        # Quarantine
        local quarantine
        quarantine=$(api_get "quarantine")
        if [ -n "$quarantine" ] && [ "$quarantine" != "[]" ]; then
            local q_count
            q_count=$(echo "$quarantine" | tr -cd ',' | wc -c)
            q_count=$((q_count + 1))
            echo -e "  ${BOLD}Quarantine${NC}  ${YELLOW}${q_count} device(s) quarantined${NC} — run ${DIM}aegis quarantine${NC} to see"
        fi
    fi

    echo ""
}

